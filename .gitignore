# OSX
.DS_Store

# IDE
.vscode/
.idea/

# node.js
node_modules/
npm-debug.log
yarn-error.log
.env
logs
# Firebase FCM credentials
serviceAccountKey.json

# Local .terraform directories
.terraform/

# OpenTofu/Terraform provider lock files (generated on tofu init, not tracked for
# reusable modules — only root config lock files are committed)
tf-modules/**/.terraform.lock.hcl

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Root-config .tfvars files (e.g. do/atesmaps/prod.tfvars) ARE committed — they hold
# non-secret config (region, sizes, a public SSH key, alert email), never credentials.

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
# example: *tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Optional: ignore graph output files generated by `terraform graph`
# *.dot

# Optional: ignore plan files saved before destroying Terraform configuration
# Uncomment the line below if you want to ignore planout files.
# planout
